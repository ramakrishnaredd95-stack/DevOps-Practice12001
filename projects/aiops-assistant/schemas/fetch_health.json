{
  "openapi": "3.0.0",
  "info": {
    "title": "AKS Health Checker",
    "version": "2.0.0",
    "description": "Checks health status of AKS workloads using Prometheus and kube-state-metrics."
  },
  "paths": {
    "/fetch-health": {
      "post": {
        "summary": "Check AKS workload health",
        "description": "Checks deployment availability, pod restarts, CPU, and memory for an AKS namespace. Use this when the user asks if services are running, pods are healthy, deployments are unavailable, or anything is down.",
        "operationId": "fetch_service_health",
        "parameters": [
          {
            "name": "cluster_name",
            "in": "query",
            "required": false,
            "description": "AKS cluster name to report in the response.",
            "schema": {
              "type": "string",
              "default": "boutique-aks"
            }
          },
          {
            "name": "namespace",
            "in": "query",
            "required": false,
            "description": "Kubernetes namespace to check deployments and pods in.",
            "schema": {
              "type": "string",
              "default": "boutique"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "AKS workload health status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cluster_healthy": { "type": "boolean" },
                    "deployments": { "type": "array" },
                    "unhealthy_deployments": { "type": "array" },
                    "crashing_pods": { "type": "array" },
                    "resource_usage": { "type": "array" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
