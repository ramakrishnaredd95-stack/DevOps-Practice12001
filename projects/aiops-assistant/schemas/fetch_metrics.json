{
  "openapi": "3.0.0",
  "info": {
    "title": "Prometheus Metrics Fetcher",
    "version": "2.0.0",
    "description": "Fetches AKS workload metrics from Prometheus."
  },
  "paths": {
    "/fetch-metrics": {
      "post": {
        "summary": "Fetch workload metrics from Prometheus",
        "description": "Retrieves Prometheus metrics for AKS pods, deployments, restarts, HTTP request rates, and request latency.",
        "operationId": "fetch_metrics",
        "parameters": [
          {
            "name": "metric_name",
            "in": "query",
            "required": true,
            "description": "Metric to retrieve. Use one of: pod_cpu_utilization, pod_memory_utilization, pod_restarts, deployment_replicas_unavailable, deployment_replicas_available, http_requests_total, http_request_duration_seconds.",
            "schema": { "type": "string" }
          },
          {
            "name": "namespace",
            "in": "query",
            "required": false,
            "description": "Kubernetes namespace to inspect.",
            "schema": { "type": "string", "default": "boutique" }
          },
          {
            "name": "hours_back",
            "in": "query",
            "required": false,
            "description": "How many hours of data to retrieve.",
            "schema": { "type": "string", "default": "1" }
          }
        ],
        "responses": {
          "200": {
            "description": "Metric data points",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "metric_name": { "type": "string" },
                    "metrics": { "type": "array" },
                    "count": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
